# Cấu hình kết nối MariaDB/MySQL cho FashionShop MCP Server
# Sao chép file này thành .env và điền thông tin thật của máy bạn
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fashionshop

# Tài khoản MCP (Xem file init-mcp-user.sql để tạo user bảo mật với quyền tối thiểu)
DB_USER=fashionshop_mcp
DB_PASSWORD=mcp_secret_pass_2026
